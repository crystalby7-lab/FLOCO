rules_version = '2';
// FLOCO 보안 규칙: 내 정보는 나만, 길드는 그 길드 멤버만 읽고 쓴다.
// 초대 코드(문서 id)를 아는 사람은 자기 자신을 멤버로 한 명 추가하는 것만 할 수 있다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /guilds/{code} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;
      // 멤버는 길드 내용을 바꿀 수 있지만 (2026-11-22 강화)
      // - 멤버 목록은 그대로 두거나 나만 빠질 수 있다 (남을 빼거나 넣지 못함)
      // - 길드 만든 시각·코드는 못 바꾼다
      // - 공용 코인은 한 번에 3,000 넘게 늘릴 수 없다 (레슨·주간·출석 보상 합보다 넉넉하게)
      allow update: if request.auth != null && (
        (
          request.auth.uid in resource.data.memberIds
          && (
            request.resource.data.memberIds == resource.data.memberIds
            || request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          )
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.code == resource.data.code
          && request.resource.data.gold <= resource.data.gold + 3000
        )
        || (
          !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() <= 5
        )
      );
    }
  }
}
